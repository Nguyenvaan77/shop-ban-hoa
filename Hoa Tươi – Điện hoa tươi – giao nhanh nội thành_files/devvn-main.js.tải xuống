            e && $.magnificPopup.close(),
                setTimeout(function () {
                    if (matchMedia('only screen and (max-width: 849px)').matches) {
                        $('body .header-cart-link.off-canvas-toggle').trigger('click');
                    }
                }, e);
        }*/

        $('body').on('click','#ftwp-container.ftwp-wrap #ftwp-header',function (e) {
            e.preventDefault();
            let buttonShow = $('button.ftwp-icon-collapse', this), parents = $(this).closest('nav#ftwp-contents');
            $('div#ftwp-container-outer').css('height','auto');
            parents.css('height','auto');
            if ($('ol#ftwp-list', parents).is(':visible')){
                $('ol#ftwp-list', parents).css('height','0');
                $('ol#ftwp-list', parents).slideUp();
                $(this).removeClass('active');
                $('button#ftwp-header-minimize', this).removeClass('ftwp-icon-expand').addClass('ftwp-icon-collapse');

            }else {
                $('ol#ftwp-list', parents).css('height','auto');
                $('ol#ftwp-list', parents).slideDown();
                $(this).addClass('active');
                $('button#ftwp-header-minimize', this).removeClass('ftwp-icon-collapse').addClass('ftwp-icon-expand');
            }
        });

    });
})(jQuery);